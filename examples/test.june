fun fib(n: int): int [
    var a = 0;
    var b = 1;
    var c = 0;
    var i = 1;

    if (n == 0) return 0;

    while (i < n) [
        c = b;
        b = a + b;
        a = c;
        i = i + 1;
    ]

    return b;
]

fun test(): int [
    var sum = 10;

    if (sum < 3) [
        sum = 3;
    ] else [
        sum = 12 * 8;
    ]

    return sum;
]


fun test2(): float [
    var a = 20.5;

    while (1 < 2) [
        a += 1.0;    
    ]

    return a;
]
