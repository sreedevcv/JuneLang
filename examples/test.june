fun factorial(val: int): int [
    var fact = 1;

    for (var i = 2; i <= val; i+=1) [
        fact *= i;
    ]

    return fact;
]

fun recursive(val: int): int [
    if (val == 1) return 1;

    return recursive(val - 1) * val;
]


var f = recursive(5);

print "Factorial of 5 is: ";
print f;
print ' ';


var a = {1, 2, 3 + 1, 4, 5};
print "Sum of elemnts of list: ";
print a;
print "is: ";

fun sum_of_items(list: [int], size: int) : int [
    var sum = 0;
    for (var i = 0; i < size; i +=1 ) [
        sum += list[i];
    ]
    return sum;
]

print sum_of_items(a, 5);

print ' ';

print "Hello world";

fun test(c: char) [

print c;
]

